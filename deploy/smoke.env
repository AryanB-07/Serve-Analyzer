# Settings for the local/CI smoke test of the production images (not for real deployments).
# Used by deploy/docker-compose.smoke.yml; see docs/deployment.md, "Smoke-testing the images".
DOMAIN=localhost
POSTGRES_PASSWORD=smoke
WORKERS=1
API_PROCESSES=1
SERVE_API_SECRET=smoke-test-secret-not-for-production
SERVE_API_DATABASE_URL=postgresql://serve:smoke@postgres:5432/serve_analyzer
SERVE_API_STORAGE=local
SERVE_API_APP_URL=https://localhost:8443
SERVE_API_SMTP_HOST=mailpit
SERVE_API_SMTP_PORT=1025
SERVE_API_SMTP_SECURITY=none
SERVE_API_EMAIL_FROM=no-reply@example.com
