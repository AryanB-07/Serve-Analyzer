# Copy to deploy/.env and fill in. Never commit the real file.

# The public hostname; Caddy gets an HTTPS certificate for it automatically.
DOMAIN=serve.example.com

# Required outside development: signs upload and download URLs.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVE_API_SECRET=

# Managed Postgres (recommended). For the bundled one (--profile bundled-db), use
# postgresql://serve:<POSTGRES_PASSWORD>@postgres:5432/serve_analyzer
SERVE_API_DATABASE_URL=postgresql://user:password@your-db-host:5432/serve_analyzer
POSTGRES_PASSWORD=

# Object storage. "s3" for production; "local" keeps files in a Docker volume on this server.
SERVE_API_STORAGE=s3
SERVE_API_S3_BUCKET=serve-analyzer-uploads
SERVE_API_S3_REGION=us-east-1
# Only for S3-compatible services such as Cloudflare R2 or MinIO:
SERVE_API_S3_ENDPOINT_URL=
# Or use an instance/task role instead of keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Scaling: API processes per container, and worker containers (each runs one job at a time).
API_PROCESSES=2
WORKERS=2

# Per-user budget.
SERVE_API_DAILY_ANALYSIS_LIMIT=20
SERVE_API_MAX_ACTIVE_ANALYSES=2
